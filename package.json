{
  "name": "sentinel",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "build:api": "npm --workspace services/api run build",
    "build:packages": "npm --workspaces --if-present run build",
    "build:all": "npm run build:packages && npm run build:api && npm run build",
    "preview": "npm --workspace apps/web run preview",
    "start:api": "npm --workspace services/api run start"
  }
}
